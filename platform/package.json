{
  "name": "magic-english-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @magic-english/web",
    "dev:api": "npm run dev -w @magic-english/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "smoke:api": "node scripts/smoke-api.mjs",
    "db:generate": "npm run db:generate -w @magic-english/api",
    "db:migrate": "npm run db:migrate -w @magic-english/api",
    "db:seed": "npm run db:seed -w @magic-english/api",
    "db:demo": "npm run db:demo -w @magic-english/api",
    "db:studio": "npm run db:studio -w @magic-english/api"
  },
  "dependencies": {
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "postcss": "8.5.24",
    "typescript-eslint": "^8.62.0"
  },
  "overrides": {
    "multer": "2.2.0",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
